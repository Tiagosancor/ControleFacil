# Copie este arquivo para .env e preencha com valores reais (nunca commitar o .env)

POSTGRES_DB=controlefacil_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

ASPNETCORE_ENVIRONMENT=Development

JWT_KEY=replace-with-a-long-random-secret
JWT_ISSUER=ControleFacil
JWT_AUDIENCE=ControleFacilUsers

CORS_ALLOWED_ORIGIN=http://localhost:3000

RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_CONTACT_RECIPIENT_EMAIL=replace-with-the-inbox-that-receives-contact-form-messages

BRAPI_API_KEY=replace-with-your-brapi-api-key
