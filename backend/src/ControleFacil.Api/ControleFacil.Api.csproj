<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ControleFacil.Domain\ControleFacil.Domain.csproj" />
    <ProjectReference Include="..\ControleFacil.Application\ControleFacil.Application.csproj" />
    <ProjectReference Include="..\ControleFacil.Infrastructure\ControleFacil.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Server GC cria um heap + thread dedicada por core que o processo enxerga, o que
         em hosts compartilhados (ex.: Render free tier, 512MB) pode reservar memória bem
         acima do que essa carga baixa realmente precisa. Workstation GC usa um único heap,
         com footprint previsível — mais adequado aqui do que otimizar para throughput. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

</Project>
