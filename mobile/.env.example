# Web (Expo web) e simulador iOS: localhost aponta pra sua própria máquina, funciona direto.
# Emulador Android: troque por http://10.0.2.2:5000 (loopback especial do emulador pro host).
# Dispositivo físico: use o IP da sua máquina na rede local, ex. http://192.168.0.10:5000.
EXPO_PUBLIC_API_URL=http://localhost:5000
